{
  "id": "community.context-insights",
  "name": "context-insights",
  "version": "0.1.0",
  "engines": {
    "qoder": ">=0.5.0"
  },
  "main": "dist/node/main.cjs",
  "activationEvents": ["onView:insights"],
  "permissions": ["node.callService", "chat.revealLocalSession"],
  "contributes": {
    "views": [
      {
        "id": "insights",
        "title": {
          "default": "Context Insights",
          "translations": { "zh-CN": "上下文洞察" }
        },
        "location": "workbench",
        "entry": "dist/browser/insights.cjs"
      }
    ],
    "sidebarNavItems": [
      {
        "id": "insights-sidebar",
        "title": {
          "default": "Context Insights",
          "translations": { "zh-CN": "上下文洞察" }
        },
        "icon": "assets/context.svg",
        "viewId": "insights",
        "slot": "workbench.sidebar.secondary"
      }
    ]
  }
}
